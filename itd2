function sortPosts(mode){
  CFG.postSort = mode;
  const feed = document.querySelectorAll('.post-container, .item, .feed-card, [data-post-id]');
  const parent = document.querySelector('.feed, .feed-list, .posts') || document.querySelector('.content') || document.body;
  if(!parent) return;
  const items = Array.from(parent.querySelectorAll('.post-container, .item, .feed-card, [data-post-id]'));
  if(items.length===0) return;
  function getNum(el, selector){
    try{
      if(selector==='likes') return parseInt(el.getAttribute('data-likes')|| el.querySelector('.likes-count')?.textContent?.replace(/\D/g,'')||0)||0;
      if(selector==='comments') return parseInt(el.getAttribute('data-comments')|| el.querySelector('.comments-count')?.textContent?.replace(/\D/g,'')||0)||0;
      if(selector==='date') return new Date(el.getAttribute('data-created')|| el.querySelector('time')?.getAttribute('datetime') || Date.now()).getTime();
    }catch(e){}
    return 0;
  }
  if(mode==='likes' || mode==='comments'){
    items.sort((a,b)=> getNum(b,mode)-getNum(a,mode));
  } else if(mode==='date'){
    items.sort((a,b)=> getNum(b,'date')-getNum(a,'date'));
  }
  items.forEach(i=>parent.appendChild(i));
}
function extractAccentFromImage(dataUrl){
  try{
    const img = new Image();
    img.crossOrigin = 'Anonymous';
    img.onload = function(){
      const c = document.createElement('canvas');
      c.width = 40; c.height = 40;
      const ctx = c.getContext('2d');
      ctx.drawImage(img,0,0,40,40);
      const d = ctx.getImageData(0,0,40,40).data;
      let r=0,g=0,b=0,len=0;
      for(let i=0;i<d.length;i+=4){
        r+=d[i]; g+=d[i+1]; b+=d[i+2]; len++;
      }
      r=Math.round(r/len); g=Math.round(g/len); b=Math.round(b/len);
      const hex = rgbToHex(r,g,b);
      CFG.accentFromBg = hex;
      CFG.customColor = hex;
      saveCfg(CFG);
      document.documentElement.style.setProperty('--itd-primary',hex);
      document.documentElement.style.setProperty('--itd-primary-rgb',hexToRgb(hex));
      showNotification('Акцент темы обновлён');
    };
    img.src = dataUrl;
  }catch(e){}
}
function rgbToHex(r,g,b){return '#'+((1<<24)+(r<<16)+(g<<8)+b).toString(16).slice(1)}
