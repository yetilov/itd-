function removeWhiteThemeVariables(){
  const styleSheets = [...document.styleSheets];
  styleSheets.forEach(ss=>{
    try{
      const rules = ss.cssRules||ss.rules;
      if(!rules) return;
      for(let i=rules.length-1;i>=0;i--){
        const r=rules[i];
        if(r.cssText && /:root\s*\{[^}]*--color-background: #fff/i.test(r.cssText)){
          try{ss.deleteRule(i);}catch(e){}
        }
      }
    }catch(e){}
  });
}
function addRainCanvas(){
  if(document.querySelector('.itd-rain-canvas')) return;
  const canvas = document.createElement('canvas');
  canvas.className = 'itd-rain-canvas';
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
  document.body.appendChild(canvas);
  const ctx = canvas.getContext('2d');
  const drops = [];
  const dropCount = Math.floor(window.innerWidth/15);
  for(let i=0;i<dropCount;i++){
    drops.push({x:Math.random()*canvas.width,y:Math.random()*canvas.height,vy:4+Math.random()*10,len:10+Math.random()*40,opacity:0.2+Math.random()*0.6});
  }
  function resize(){canvas.width=window.innerWidth;canvas.height=window.innerHeight;}
  window.addEventListener('resize',resize);
  function draw(){
    ctx.clearRect(0,0,canvas.width,canvas.height);
    ctx.globalCompositeOperation = 'source-over';
    drops.forEach(d=>{
      ctx.beginPath();
      ctx.strokeStyle = `rgba(200,220,255,${d.opacity})`;
      ctx.lineWidth = 1;
      ctx.moveTo(d.x, d.y);
      ctx.lineTo(d.x + d.vy*0.2, d.y + d.len);
      ctx.stroke();
      d.x += d.vy*0.6;
      d.y += d.vy;
      if(d.y>canvas.height+50 || d.x>canvas.width+50){
        d.x = Math.random()*canvas.width*0.5;
        d.y = -20 - Math.random()*200;
        d.vy = 4+Math.random()*10;
        d.len = 10+Math.random()*40;
      }
    });
    requestAnimationFrame(draw);
  }
  draw();
}
