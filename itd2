    function init(){applyAllStyles();addSettingsButton();setInterval(addSettingsButton,CONFIG.CHECK_INTERVAL);initEmojiSystem();initBannerUpload();initAvatarReplacement();if(typeof GM_registerMenuCommand!=='undefined'){GM_registerMenuCommand('⚙️ Настройки',openSettingsModal)}window.addEventListener('load',()=>{setTimeout(()=>{applyPostSorting();resizeRain()},800)})}
    init();
})();