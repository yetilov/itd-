    function initEmojiSystem(){if(!settings.emojiEnabled)return;const style=document.createElement('style');style.id='apple-emoji-styles';style.textContent=`.apple-emoji{font-size:inherit!important;line-height:inherit!important;vertical-align:text-bottom!important;display:inline-block!important;}`;document.head.appendChild(style);const emojiConfig={emojiSource:'https://cdn.jsdelivr.net/npm/emoji-datasource-apple@15.1.2/img/apple/64',imageFormat:'png'};const emojiCache=new Map();function getEmojiCode(emojiChar){let fullCode='';for(let i=0;i<emojiChar.length;i++){const codePoint=emojiChar.codePointAt(i);if(codePoint){let charCode=codePoint.toString(16).toLowerCase();fullCode+=(fullCode?'-':'')+charCode;if(codePoint>0xFFFF)i++}}return fullCode.replace(/-fe0f/g,'').replace(/fe0f-?/g,'').replace(/-+/g,'-').replace(/^-|-$/g,'')};function getAppleEmojiUrl(emojiCode){return`${emojiConfig.emojiSource}/${emojiCode}.${emojiConfig.imageFormat}`};function createEmojiElement(emojiChar){const emojiCode=getEmojiCode(emojiChar);if(!emojiCode)return document.createTextNode(emojiChar);if(emojiCache.has(emojiChar))return emojiCache.get(emojiChar).cloneNode(true);const container=document.createElement('span');container.className='apple-emoji-container';const img=document.createElement('img');img.src=getAppleEmojiUrl(emojiCode);img.alt=emojiChar;img.className='apple-emoji';img.style.cssText='display:inline-block;vertical-align:text-bottom;font-size:inherit;line-height:inherit;height:1.2em;width:auto;max-width:1.2em;min-width:1em;object-fit:contain;margin:0 0.05em;';container.appendChild(img);emojiCache.set(emojiChar,container.cloneNode(true));return container};processEmojiDOM=function(root=document.body){const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT,{acceptNode:node=>node.textContent.trim().match(/[\p{Emoji}]/u)?NodeFilter.FILTER_ACCEPT:NodeFilter.FILTER_REJECT});let node;while(node=walker.nextNode()){const text=node.textContent;const matches=[...text.matchAll(/[\p{Emo